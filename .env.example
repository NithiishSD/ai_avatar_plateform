

# --- Database (PostgreSQL) Configuration ---
POSTGRES_DB=avatar_platform
POSTGRES_USER=avatar_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis Broker Configuration ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Queue & Task Routing ---
# Options: 'in_memory' (fast local testing without Celery/Redis) or 'celery' (production async GPU queue)
QUEUE_BACKEND=in_memory

# --- Broker & Backend Connection URLs ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
DATABASE_URL=postgresql://avatar_user:your_secure_password_here@localhost:5432/avatar_platform